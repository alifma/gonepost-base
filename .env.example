# API
APP_ENV=local
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (development)
POSTGRES_DB=basecode
POSTGRES_USER=basecode
POSTGRES_PASSWORD=basecode
POSTGRES_PORT=5432
DATABASE_URL=postgres://basecode:basecode@localhost:5432/basecode?sslmode=disable

# PostgreSQL (integration tests — separate database, never the dev one)
TEST_POSTGRES_DB=basecode_test
TEST_POSTGRES_PORT=5433
TEST_DATABASE_URL=postgres://basecode:basecode@localhost:5433/basecode_test?sslmode=disable
