{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (cmd/api)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/api/cmd/api",
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "APP_ENV": "local",
        "PORT": "8080",
        "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
        "DATABASE_URL": "postgres://basecode:basecode@localhost:5432/basecode?sslmode=disable"
      }
    },
    {
      "name": "Debug current Go test file",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Run Web (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "Run Local Stack",
      "configurations": ["Debug API (cmd/api)", "Run Web (Next.js)"]
    }
  ]
}
