{
  "name": "@gonepost/api-client",
  "version": "1.0.0",
  "description": "Typed HTTP client for the Gonepost API, generated from apps/api/openapi/openapi.yaml",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ../../apps/api/openapi/openapi.yaml -o src/types.gen.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
